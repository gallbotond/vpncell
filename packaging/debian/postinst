#!/bin/sh
# vpncell postinst
set -e
case "$1" in
configure)
	getent group vpncell >/dev/null || addgroup --system vpncell >/dev/null
	install -d -m 0755 /etc/vpncell/profiles.d
	install -d -m 0700 /etc/vpncell/secrets
	install -d -m 0700 /var/lib/vpncell
	# Firefox policy against the HTTPS-First DNS lookup outside the proxy
	# (README "Firefox"). Installed once; if the admin removes it with
	# `vpncell firefox-policy remove`, upgrades do not add it again. A purge
	# forgets that choice.
	if [ ! -e /var/lib/vpncell/firefox-policy-installed ]; then
		if /usr/bin/vpncell firefox-policy install >/dev/null; then
			touch /var/lib/vpncell/firefox-policy-installed
			echo "vpncell: Firefox policy installed in /etc/firefox/policies/policies.json (restart Firefox)"
		else
			echo "vpncell: could not install the Firefox policy; see README \"Firefox\"" >&2
		fi
	fi
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload >/dev/null 2>&1 || true
		# NetworkManager: never manage tunnel devices (they exist briefly in
		# the host namespace before they move into a profile).
		systemctl try-reload-or-restart NetworkManager.service >/dev/null 2>&1 || true
		systemctl enable vpncelld.service >/dev/null 2>&1 || true
		if [ -n "$2" ]; then
			# Upgrade: restart without stopping profiles. The new daemon
			# adopts namespaces, tunnels, SOCKS ports and sessions.
			systemctl restart vpncelld.service || true
		else
			systemctl start vpncelld.service || true
		fi
	fi
	if [ -z "$2" ]; then
		echo "vpncell: add users to the 'vpncell' group (sudo usermod -aG vpncell USER), then log out of the"
		echo "vpncell: desktop and in again (a new terminal is not enough; 'newgrp vpncell' works for one shell),"
		echo "vpncell: import a profile with: sudo vpncell import NAME FILE"
		echo "vpncell: for Firefox see /usr/share/doc/vpncell/README.md (extension, firefox-policy)"
	fi
	;;
esac
exit 0
