#!/bin/sh
# vpncell postrm
set -e
case "$1" in
remove)
	[ -d /run/systemd/system ] && systemctl daemon-reload >/dev/null 2>&1 || true
	systemctl try-reload-or-restart NetworkManager.service >/dev/null 2>&1 || true
	;;
purge)
	rm -rf /etc/vpncell /var/lib/vpncell /run/vpncell
	getent group vpncell >/dev/null && delgroup --system vpncell >/dev/null 2>&1 || true
	;;
esac
exit 0
